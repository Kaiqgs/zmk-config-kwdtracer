#define ZMK_POINTING_DEFAULT_MOVE_VAL 750
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hrm: behavior_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            #binding-cells = <2>;
            bindings = <&kp &kp>;
            tapping-term-ms = <150>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <70>;
            hold-trigger-on-release;
        };

        /*
         * Uppercase for the dead-key accents only.
         *
         * mod-morph masks its trigger mods by default, so shift both selects the
         * uppercase branch AND is stripped before the prefix goes out. Without
         * that, a leaked shift would turn AltGr+` (dead_grave) into AltGr+shift+`
         * (dead_tilde), and A-grave would silently come out as A-tilde.
         */
        pt_ac: pt_ac { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&dk_circ A>, <&dk_circ LS(A)>; mods = <(MOD_LSFT|MOD_RSFT)>; };  // â Â
        pt_ec: pt_ec { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&dk_circ E>, <&dk_circ LS(E)>; mods = <(MOD_LSFT|MOD_RSFT)>; };  // ê Ê
        pt_oc: pt_oc { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&dk_circ O>, <&dk_circ LS(O)>; mods = <(MOD_LSFT|MOD_RSFT)>; };  // ô Ô
        pt_at: pt_at { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&dk_tilde A>, <&dk_tilde LS(A)>; mods = <(MOD_LSFT|MOD_RSFT)>; };  // ã Ã
        pt_ot: pt_ot { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&dk_tilde O>, <&dk_tilde LS(O)>; mods = <(MOD_LSFT|MOD_RSFT)>; };  // õ Õ
        pt_ag: pt_ag { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&dk_grave A>, <&dk_grave LS(A)>; mods = <(MOD_LSFT|MOD_RSFT)>; };  // à À
    };

    macros {
        /*
         * Dead-key prefixes, for the three accents the layout does NOT map
         * directly. Layout: setxkbmap us -variant altgr-intl
         *
         *   AltGr+6         dead_circumflex
         *   AltGr+`         dead_grave
         *   AltGr+shift+`   dead_tilde
         *
         * The acutes, the trema and the cedilla need none of this: altgr-intl
         * includes us(intl), which puts them straight on AltGr+letter, with the
         * capital sitting on level 4 so shift works by itself. See the layer.
         */
        dk_circ:  dk_circ  { compatible = "zmk,behavior-macro-one-param"; #binding-cells = <1>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp RA(N6)>,        <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>; };
        dk_grave: dk_grave { compatible = "zmk,behavior-macro-one-param"; #binding-cells = <1>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp RA(GRAVE)>,     <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>; };
        dk_tilde: dk_tilde { compatible = "zmk,behavior-macro-one-param"; #binding-cells = <1>; wait-ms = <10>; tap-ms = <10>; bindings = <&kp RA(LS(GRAVE))>, <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>; };
    };

    keymap {
        compatible = "zmk,keymap";

        colemodh {
            display-name = "Default Layer";
            bindings = <
&kp Q         &kp W        &kp F         &kp P         &kp B        &lt 3 ESC    &lt 8 DEL  &kp J          &kp L         &kp U         &kp Y        &kp SEMI
&hrm LMETA A  &hrm LALT R  &hrm LCTRL S  &hrm LSHFT T  &kp G        &lt 4 TAB    &mo 6      &kp M          &hrm RSHFT N  &hrm RCTRL E  &hrm RALT I  &hrm RMETA O
&kp Z         &kp X        &kp C         &kp D         &kp V        &lt 7 ENTER  &mo 7      &kp K          &kp H         &kp COMMA     &kp DOT      &kp SLASH
              &kp DOWN     &kp UP        &kp SPACE     &lt 2 SPACE                          &kp BACKSPACE  &lt 5 ENTER   &kp LEFT      &kp RIGHT
            >;
        };

        game {
            bindings = <
&kp TAB    &kp N1  &kp N2  &kp N3     &kp N4     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp Q   &kp W   &kp E      &kp T      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp A   &kp S   &kp D      &kp F      &trans  &trans  &trans  &trans  &trans  &trans  &trans
           &trans  &trans  &kp SPACE  &kp SPACE                  &trans  &trans  &trans  &trans
            >;
        };

        symbols {
            bindings = <
&kp N1        &kp N2         &kp N3        &kp N4        &kp N5         &kp LS(DQT)  &kp GRAVE  &kp N6      &kp N7            &kp N8            &kp N9         &kp N0
&kp MINUS     &kp EQUAL      &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(UNDER)  &kp SQT      &kp SQT    &kp STAR    &hrm RSHFT QMARK  &hrm RCTRL COLON  &hrm RALT LT   &hrm LG(RGUI) GT
&kp LS(PLUS)  &kp LS(POUND)  &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(PRCNT)  &kp GRAVE    &kp GRAVE  &kp LS(AT)  &kp LBKT          &kp RBKT          &kp LS(AMPS)   &kp BSLH
              &kp LS(CARET)  &kp LS(DLLR)  &kp ESC       &none                                  &mo 9       &kp LS(DQT)       &kp LS(EXCL)      &kp LS(TILDE)
            >;
        };

        numbers {
            bindings = <
&kp J  &kp L     &kp U      &kp Y     &kp SEMI  &none          &none    &kp LBKT  &kp N7         &kp N8  &kp N9      &kp PLUS
&kp O  &kp I     &kp E      &kp N     &kp M     &kp RET        &none    &kp SEMI  &kp N4         &kp N5  &kp N6      &kp MINUS
&kp K  &kp H     &kp COMMA  &kp DOT   &kp FSLH  &kp KP_DIVIDE  &kp DOT  &kp RET   &kp N1         &kp N2  &kp N3      &kp EQUAL
       &kp LEFT  &kp RIGHT  &kp BSPC  &kp DEL                           &kp N0    &kp KP_DIVIDE  &kp N0  &kp KP_DOT
            >;
        };

        functions {
            bindings = <
&kp F1      &kp F2           &kp F3     &kp F4     &kp F5    &trans  &trans  &kp F6  &kp F7     &kp F8     &kp F9    &kp F10
&caps_word  &kp PRINTSCREEN  &kp LC(S)  &kp LC(N)  &kp BSPC  &trans  &trans  &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RMETA
&kp HOME    &kp PG_UP        &kp PG_DN  &kp END    &kp RET   &trans  &trans  &trans  &trans     &trans     &trans    &trans
            &kp F11          &kp F12    &kp DEL    &trans                    &trans  &trans     &kp F13    &kp F14
            >;
        };

        neovim {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &none  &none  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&none   &none   &none   &none   &none   &none  &none  &none   &kp H   &kp J   &kp K   &kp L
&none   &none   &none   &none   &none   &none  &none  &none   &none   &none   &none   &none
        &none   &none   &none   &none                 &none   &none   &none   &none
            >;
        };

        media {
            bindings = <
&none  &none  &none  &none   &none   &trans  &kp K_STOP  &none             &none           &none         &none            &none
&none  &none  &none  &none   &none   &trans  &trans      &none             &kp K_PREVIOUS  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp K_NEXT
&none  &none  &none  &none   &none   &trans  &trans      &none             &none           &none         &none            &none
       &none  &none  &trans  &trans                      &kp K_PLAY_PAUSE  &kp K_MUTE      &none         &none
            >;
        };

        system {
            bindings = <
&kp K_PWR       &bt BT_DISC 0  &bt BT_DISC 1     &bt BT_DISC 2      &kp K_SLEEP        &bt BT_CLR  &bt BT_CLR  &kp K_SLEEP        &bt BT_DISC 0      &bt BT_DISC 1     &bt BT_DISC 2  &kp K_POWER
&none           &bt BT_SEL 0   &bt BT_SEL 1      &bt BT_SEL 2       &none              &soft_off   &soft_off   &none              &bt BT_SEL 0       &bt BT_SEL 1      &bt BT_SEL 2   &none
&bt BT_CLR_ALL  &none          &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &none       &none       &ext_power EP_TOG  &ext_power EP_OFF  &ext_power EP_ON  &none          &bt BT_CLR_ALL
                &to 0          &to 1             &sys_reset         &bootloader                                &bootloader        &sys_reset         &to 1             &to 0
            >;
        };

        mouse {
            bindings = <
&trans     &trans        &trans     &trans      &trans  &trans  &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT
&kp LMETA  &kp LEFT_ALT  &kp LCTRL  &kp LSHIFT  &trans  &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&trans     &trans        &trans     &trans      &trans  &trans  &trans  &trans  &mkp LCLK       &mkp MCLK       &mkp MB5      &mkp RCLK
           &trans        &trans     &trans      &trans                  &trans  &trans          &trans          &trans
            >;
        };

        accents {
            display-name = "Accents";
            bindings = <
&pt_ac      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RA(U)  &kp RA(Y)  &pt_oc
&kp RA(A)   &pt_ag  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp RA(E)  &kp RA(I)  &kp RA(O)
&pt_at      &trans  &kp RA(COMMA)   &trans  &trans  &trans  &trans  &trans  &trans  &pt_ec  &trans  &pt_ot
        &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans
            >;
        };
    };
};

&mmv {
    time-to-max-speed-ms = <150>;
    acceleration-exponent = <1>;
};

&msc {
    time-to-max-speed-ms = <150>;
    acceleration-exponent = <0>;
};
